# 首次运行前复制为 .env，并务必修改两个密码。
WECHAT_DB_DIR=D:\xwechat_files

POSTGRES_DB=wechat_archive
POSTGRES_USER=wechat
POSTGRES_PASSWORD=replace-this-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

MINIO_ROOT_USER=wechatadmin
MINIO_ROOT_PASSWORD=replace-this-minio-password
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=wechat-media
MINIO_SECURE=false

# 媒体暂未落地时最多重试次数；达到上限后标记 failed。
MEDIA_MAX_RETRIES=20

# 千问。API Key 只写入本机 deploy/.env，不要提交到 Git。
DASHSCOPE_API_KEY=replace-this-dashscope-api-key
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-flash
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_HTTP_TIMEOUT=60
QWEN_ASR_MAX_BYTES=10485760
